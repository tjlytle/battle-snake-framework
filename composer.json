{
    "name": "timlytle/battlesnake-platform",
    "description": "A simple PHP platform for building Battlesnake bots",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "crell/serde": "^1.3",
        "crell/tukio": "^2.0",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.3",
        "eventsauce/eventsauce": "^3.4",
        "eventsauce/message-repository-for-doctrine": "^1.0",
        "eventsauce/message-repository-table-schema": "^1.0",
        "laminas/laminas-diactoros": "^3.5",
        "php-di/php-di": "^7.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "ramsey/uuid": "^4.7",
        "symfony/cache": "^7.2",
        "symfony/var-exporter": "^7.0"
    },
    "require-dev": {
        "behat/behat": "^3.21",
        "eventsauce/test-utilities": "^3.9",
        "league/openapi-psr7-validator": "^0.22.0",
        "phpspec/prophecy-phpunit": "^2.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "BattleSnake\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BattleSnake\\Tests\\": "test/",
            "BattleSnake\\Tests\\Behat\\": "test/Behat/bootstrap/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "migrate": "doctrine-migrations migrate --no-interaction",
        "test": "phpunit",
        "behat": "behat",
        "stan": "phpstan analyse",
        "cs": "phpcs"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
